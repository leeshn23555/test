# Copy this file to .env on your own computer.
# Never commit .env or paste API keys into chat.
# Keep DEMO_MODE=true until a parent/guardian has reviewed provider terms and any possible costs.
DEMO_MODE=true
PORT=3000

# Provider API keys: leave blank until safely configured locally.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=

# Set model IDs to models actually available to your provider account.
# Model names change; these placeholders intentionally do not guess a current model.
OPENAI_MODEL=replace-with-available-model-id
GEMINI_MODEL=replace-with-available-model-id
ANTHROPIC_MODEL=replace-with-available-model-id
PERPLEXITY_MODEL=replace-with-available-model-id
XAI_MODEL=replace-with-available-model-id
